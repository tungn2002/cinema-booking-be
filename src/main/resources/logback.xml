<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Console output is important for Docker as it goes to container logs -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <!-- Add color highlights for better readability -->
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %magenta([%thread]) %highlight(%-5level) %logger{36}.%M - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- In Docker, we'll use a volume mount for persistent logs if needed -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>/app/logs/application.log</file>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36}.%M - %msg%n</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- Nén file cũ theo ngày -->
            <fileNamePattern>/app/logs/archived/application-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <!-- Cắt file nếu vượt quá 10MB -->
            <maxFileSize>10MB</maxFileSize>
            <!-- Chỉ giữ log của 30 ngày gần nhất, cũ hơn tự động xóa -->
            <maxHistory>30</maxHistory>
        </rollingPolicy>
    </appender>

    <!-- Set default log level from properties -->
    <root level="${logging.level.root:-INFO}">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
    </root>

    <!-- Application specific logging -->
    <logger name="com.personal.cinemabooking" level="${logging.level.com.personal.cinemabooking:-INFO}" />
    <logger name="org.springframework.security" level="${logging.level.org.springframework.security:-INFO}" />
</configuration>
